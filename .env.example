# Factory (Render Web Service)
DATABASE_URL=postgresql://user:pass@host:5432/campaign_factory_db?sslmode=require
FACTORY_ENCRYPTION_KEY=PASTE_64_HEX_FROM_npm_run_generate-encryption-key
FACTORY_BOOTSTRAP_SECRET=choose-a-strong-one-time-secret
FACTORY_REQUIRE_2FA=true
VERCEL_TOKEN=
VERCEL_TEAM_ID=
TENANT_GIT_REPO=your-org/campaign-site-template
TENANT_GIT_REPO_ID=
TENANT_BASE_DOMAIN=campaigns.example.com
PORT=3000

# Tenant (Vercel per-site)
# DATABASE_URL=same-shared-render-url
# DB_SCHEMA=tenant_123
